---
import "../styles/global.css";
import DomainAlert from "../components/DomainAlert.svelte";

interface Props {
	title: string;
}

const { title } = Astro.props;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A Proof-of-Teamwork Stellar asset powered by Soroban" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:title" content={title}>
		<meta property="og:description" content="A Proof-of-Teamwork Stellar asset powered by Soroban">
		<meta property="og:image" content="https://farm.kalepail.com/meta.jpg">
		<meta property="og:url" content="https://farm.kalepail.com/">
		<meta property="og:type" content="website">

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content="A Proof-of-Teamwork Stellar asset powered by Soroban">
		<meta name="twitter:image" content="https://farm.kalepail.com/meta.jpg">

		{isProd && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" is:inline></script>}
	</head>
	<body>
		<DomainAlert client:only="svelte" />
		<slot />

		{isProd && <div class="cf-turnstile"></div>}

		<script>
			import { turnstileCallback } from "../store/turnstileToken";

			if (import.meta.env.PROD) {
				turnstile.ready(() => {
					turnstile.render(".cf-turnstile", {
						appearance: "interaction-only",
						sitekey: '0x4AAAAAABBPiK_8QHc6n8E4',
						'response-field': false,
						// @ts-ignore
						'feedback-enabled': false,
						callback: (token: string) => turnstileCallback(token),
						'error-callback': (error: any) => console.error(error),
					});
				});
			}
		</script>
	</body>
</html>
