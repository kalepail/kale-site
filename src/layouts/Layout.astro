---
interface Props {
	title: string;
}

const { title } = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A Proof-of-Teamwork Stellar asset powered by Soroban" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<meta property="og:title" content={title}>
		<meta property="og:description" content="A Proof-of-Teamwork Stellar asset powered by Soroban">
		<meta property="og:image" content="https://farm.kalepail.com/meta.jpg">
		<meta property="og:url" content="https://farm.kalepail.com/">
		<meta property="og:type" content="website">

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content="A Proof-of-Teamwork Stellar asset powered by Soroban">
		<meta name="twitter:image" content="https://farm.kalepail.com/meta.jpg">

		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" is:inline></script>
	</head>
	<body>
		<slot />

		<div class="cf-turnstile"></div>

		<script>
			import { turnstileCallback } from "../store/turnstileToken";

			turnstile.ready(() => {
				turnstile.render(".cf-turnstile", {
					appearance: "interaction-only",
					sitekey: `${import.meta.env.PROD ? '0x4AAAAAABBPiK_8QHc6n8E4' : '1x00000000000000000000AA'}`,
					'response-field': false,
					// @ts-ignore
					'feedback-enabled': false,
					callback: (token: string) => turnstileCallback(token),
					'error-callback': (error: any) => console.error(error),
				});
			});
		</script>
	</body>
</html>
